@model IEnumerable<Venue>
@{ ViewData["Title"] = "Venues"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-header mb-0"><i class="bi bi-building"></i> Venues</h1>
    <a asp-action="Create" class="btn btn-accent"><i class="bi bi-plus-lg"></i> Add Venue</a>
</div>
<form asp-action="Index" method="get" class="mb-4"><div class="input-group" style="max-width:400px;"><input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search venues..." /><button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button></div></form>
@if (Model.Any()) {
<div class="row g-4">
@foreach (var venue in Model) {
<div class="col-md-6 col-lg-4"><div class="card venue-card h-100">
@if (!string.IsNullOrEmpty(venue.ImageUrl)) { <img src="@venue.ImageUrl" class="card-img-top" alt="@venue.VenueName" style="height:200px;object-fit:cover;" /> }
else { <div class="card-img-placeholder"><i class="bi bi-building"></i></div> }
<div class="card-body">
    <h5 class="card-title fw-bold">@venue.VenueName</h5>
    <div class="d-flex gap-3 text-muted mb-2" style="font-size: 0.9rem;">
        <span><i class="bi bi-geo-alt-fill"></i> @venue.Location</span>
        <span><i class="bi bi-people-fill"></i> @venue.Capacity</span>
    </div>
</div>
<div class="card-footer bg-white border-top-0 pb-3">
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</a>
        <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
</div></div> }
</div> } else { <div class="text-center py-5 text-muted"><i class="bi bi-building display-3"></i><p class="mt-2">No venues found.</p></div> }
