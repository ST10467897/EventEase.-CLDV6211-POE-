@model Venue
@{ ViewData["Title"] = "Delete Venue"; var hasDeps = (bool)(ViewData["HasDependencies"] ?? false); }
<h1 class="page-header text-danger"><i class="bi bi-trash"></i> Delete Venue</h1>
<div class="row"><div class="col-md-8 col-lg-6"><div class="card p-4">
@if (hasDeps) { <div class="alert alert-warning"><strong>Cannot delete.</strong> This venue has associated events or bookings.</div> }
else { <div class="alert alert-danger">Are you sure you want to permanently delete this venue?</div> }
<dl class="row mb-3"><dt class="col-sm-4">Venue Name</dt><dd class="col-sm-8">@Model.VenueName</dd><dt class="col-sm-4">Location</dt><dd class="col-sm-8">@Model.Location</dd><dt class="col-sm-4">Capacity</dt><dd class="col-sm-8">@Model.Capacity</dd></dl>
<div class="d-flex gap-2">@if (!hasDeps) { <form asp-action="Delete"><input type="hidden" asp-for="VenueId" /><button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button></form> }<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a></div>
</div></div></div>
