@model Venue
@{ ViewData["Title"] = "Add Venue"; }
<h1 class="page-header"><i class="bi bi-plus-circle"></i> Add Venue</h1>
<div class="row"><div class="col-md-8 col-lg-6"><div class="card p-4">
<form asp-action="Create" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="mb-3"><label asp-for="VenueName" class="form-label"></label><input asp-for="VenueName" class="form-control" placeholder="e.g. Grand Ballroom" /><span asp-validation-for="VenueName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" placeholder="e.g. 123 Main St, Johannesburg" /><span asp-validation-for="Location" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" type="number" min="1" /><span asp-validation-for="Capacity" class="text-danger"></span></div>
<div class="mb-3">
    <label class="form-label">Venue Image</label>
    <label for="imageFile" class="upload-area d-block">
        <div class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
        <div class="upload-text">Click to upload or drag & drop</div>
        <div class="upload-hint">JPG, PNG up to 5MB</div>
        <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png" class="d-none" />
    </label>
</div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Create Venue</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
