@model Event
@{ ViewData["Title"] = "Delete Event"; var hasDeps = (bool)(ViewData["HasDependencies"] ?? false); }
<h1 class="page-header text-danger"><i class="bi bi-trash"></i> Delete Event</h1>
<div class="row"><div class="col-md-8 col-lg-6"><div class="card p-4">
@if (hasDeps) { <div class="alert alert-warning"><strong>Cannot delete.</strong> This event has associated bookings.</div> }
else { <div class="alert alert-danger">Are you sure you want to permanently delete this event?</div> }
<dl class="row mb-3"><dt class="col-sm-4">Event Name</dt><dd class="col-sm-8">@Model.EventName</dd><dt class="col-sm-4">Venue</dt><dd class="col-sm-8">@Model.Venue?.VenueName</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(Model.Description ?? "-")</dd></dl>
<div class="d-flex gap-2">@if (!hasDeps) { <form asp-action="Delete"><input type="hidden" asp-for="EventId" /><button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button></form> }<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a></div>
</div></div></div>
