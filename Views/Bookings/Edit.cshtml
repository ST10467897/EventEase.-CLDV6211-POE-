@model Booking
@{ ViewData["Title"] = "Edit Booking"; }
<h1 class="page-header"><i class="bi bi-pencil"></i> Edit Booking #@Model.BookingId</h1>
<div class="row"><div class="col-md-8 col-lg-6"><div class="card p-4">
<form asp-action="Edit">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div> }<input type="hidden" asp-for="BookingId" />
<div class="mb-3"><label asp-for="EventId" class="form-label"></label><select asp-for="EventId" class="form-select" asp-items="@(ViewData["EventId"] as SelectList)"><option value="">-- Select an Event --</option></select><span asp-validation-for="EventId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="VenueId" class="form-label"></label><select asp-for="VenueId" class="form-select" asp-items="@(ViewData["VenueId"] as SelectList)"><option value="">-- Select a Venue --</option></select><span asp-validation-for="VenueId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" class="form-control" type="date" /><span asp-validation-for="EventDate" class="text-danger"></span></div>
<div class="row"><div class="col-6 mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control" type="time" /><span asp-validation-for="StartTime" class="text-danger"></span></div>
<div class="col-6 mb-3"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" class="form-control" type="time" /><span asp-validation-for="EndTime" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="BookedBy" class="form-label"></label><input asp-for="BookedBy" class="form-control" /><span asp-validation-for="BookedBy" class="text-danger"></span></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Save Changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
