@model Booking
@{ ViewData["Title"] = $"Booking #{Model.BookingId}"; }
<h1 class="page-header"><i class="bi bi-bookmark-check"></i> Booking #@Model.BookingId</h1>
<div class="row"><div class="col-md-8"><div class="card p-4"><dl class="row mb-0">
<dt class="col-sm-4">Booking ID</dt><dd class="col-sm-8">#@Model.BookingId</dd>
<dt class="col-sm-4">Event</dt><dd class="col-sm-8"><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.Event?.EventName</a></dd>
<dt class="col-sm-4">Venue</dt><dd class="col-sm-8"><a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.VenueId">@Model.Venue?.VenueName</a></dd>
<dt class="col-sm-4">Date</dt><dd class="col-sm-8">@Model.EventDate.ToString("dd MMMM yyyy")</dd>
<dt class="col-sm-4">Start Time</dt><dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm")</dd>
<dt class="col-sm-4">End Time</dt><dd class="col-sm-8">@Model.EndTime.ToString(@"hh\:mm")</dd>
</dl></div><div class="mt-3 d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a><a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back</a></div></div></div>
