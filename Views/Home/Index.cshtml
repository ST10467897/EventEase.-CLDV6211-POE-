@model IEnumerable<Booking>
@{ ViewData["Title"] = "Dashboard"; }
<h1 class="page-header"><i class="bi bi-speedometer2"></i> Dashboard</h1>
<div class="row g-4 mb-4">
    <div class="col-md-4"><div class="card text-center p-4"><i class="bi bi-building display-4 text-primary"></i><h2 class="mt-3 mb-1">@ViewData["VenueCount"]</h2><p class="text-muted mb-2">Venues</p><a asp-controller="Venues" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a></div></div>
    <div class="col-md-4"><div class="card text-center p-4"><i class="bi bi-calendar3 display-4 text-success"></i><h2 class="mt-3 mb-1">@ViewData["EventCount"]</h2><p class="text-muted mb-2">Events</p><a asp-controller="Events" asp-action="Index" class="btn btn-outline-success btn-sm">View All</a></div></div>
    <div class="col-md-4"><div class="card text-center p-4"><i class="bi bi-bookmark-check display-4" style="color:var(--ee-accent);"></i><h2 class="mt-3 mb-1">@ViewData["BookingCount"]</h2><p class="text-muted mb-2">Bookings</p><a asp-controller="Bookings" asp-action="Index" class="btn btn-accent btn-sm">View All</a></div></div>
</div>
<div class="card"><div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-clock-history"></i> Upcoming Bookings</h5></div>
<div class="card-body p-0">
@if (Model.Any()) {
<table class="table table-hover mb-0"><thead><tr><th>Booking #</th><th>Event</th><th>Venue</th><th>Date</th><th>Time</th></tr></thead><tbody>
@foreach (var b in Model) { <tr><td><strong>#@b.BookingId</strong></td><td>@b.Event?.EventName</td><td>@b.Venue?.VenueName</td><td>@b.EventDate.ToString("dd MMM yyyy")</td><td>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</td></tr> }
</tbody></table>
} else { <div class="text-center py-5 text-muted"><i class="bi bi-inbox display-4"></i><p class="mt-2">No upcoming bookings.</p><a asp-controller="Bookings" asp-action="Create" class="btn btn-accent"><i class="bi bi-plus-lg"></i> Create Booking</a></div> }
</div></div>
